# Connection string do PostgreSQL (deve apontar para o banco do docker-compose)
DATABASE_URL=postgresql+asyncpg://aiops:aiops123@localhost:5432/aiops_k8s

# Chave de API da Anthropic (obrigatorio quando usar agentes)
ANTHROPIC_API_KEY=sk-ant-...

# Endpoint HTTP do MCP Server Kubernetes (executado localmente via npx, transport streamable HTTP)
MCP_SERVER_URL=http://localhost:3001/mcp

# Intervalo, em minutos, entre coletas de eventos Warning do cluster (aceita fracao, ex: 0.5)
# Valor invalido, zero ou negativo cai no padrao (3) com warning no log
EVENT_COLLECTION_INTERVAL_MINUTES=3

# Modelo Claude usado pelo agente de analise (Sonnet como override opcional)
AGENT_MODEL_NAME=claude-haiku-4-5

# Limite de chamadas ao modelo por analise (inteiro positivo; invalido cai no padrao 25)
AGENT_MAX_ITERATIONS=25

# Minutos ate um relatorio INCOMPLETO poder ser reanalisado, contados do inicio da analise (aceita fracao)
ANALYSIS_RETRY_COOLDOWN_MINUTES=30

# Minutos ate um relatorio EM_ANALISE ser considerado estagnado e marcado INCOMPLETO (aceita fracao)
ANALYSIS_STALE_TIMEOUT_MINUTES=30

# Modelo Claude do agente de correcao (escrita irrestrita no cluster); vazio usa AGENT_MODEL_NAME
CORRECTION_MODEL_NAME=

# Limite de chamadas ao modelo por correcao (inteiro positivo; invalido cai no padrao 25)
CORRECTION_MAX_ITERATIONS=25

# Tempo limite, em minutos, de uma correcao (aceita fracao; invalido cai no padrao 10)
# Correcoes em CORRIGINDO ha mais de 2x esse valor sao marcadas FALHA_CORRECAO pela varredura
CORRECTION_TIMEOUT_MINUTES=10
